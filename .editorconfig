# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Default spacing
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# JavaScript, TypeScript, Astro, JSON files
[*.{js,jsx,ts,tsx,astro,json}]
indent_size = 2

# CSS, SCSS, LESS files
[*.{css,scss,less}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Package files
[package.json]
indent_size = 2

# HTML files
[*.{htm,html}]
indent_size = 2
