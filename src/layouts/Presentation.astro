---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/HeaderBack.astro';

import "reveal.js/dist/reveal.css";
import "reveal.js/dist/theme/black.css";
import "reveal.js/plugin/highlight/zenburn.css";

type Props = CollectionEntry<'presentations'>['data'] & { content: string };

const { title, description, content } = Astro.props;

---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
            <div class="reveal">
                <div class="slides">
                    <section data-markdown>{content}</section>
                </div>
            </div>
		</main>
	</body>
</html>


<script>
    import Reveal from "reveal.js";
    import Markdown from "reveal.js/plugin/markdown/markdown.esm.js";
    import Highlight from "reveal.js/plugin/highlight/highlight.esm.js";

    let deck = new Reveal({ plugins: [Markdown, Highlight] });
    deck.initialize({embedded: true});
  </script>
